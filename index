                        <div id="form-error-box" class="hidden mt-6 p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-200 space-y-3">
                            <div class="flex items-center gap-2.5 font-bold text-base text-amber-400">
                                <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                                <span>Otomatik Gönderim Kısıtlandı veya Ağ Hatası Oluştu</span>
                            </div>
                            <p id="form-error-detail" class="text-sm text-slate-300 leading-relaxed">
                                Tarayıcı önizleme ortamı dış bağlantıyı engellemiş olabilir veya e-posta aktivasyonu henüz tamamlanmamış olabilir. Talebinizi aşağıdaki tek tık seçeneklerle anında iletebilirsiniz:
                            </p>
                            <div class="flex flex-wrap gap-3 pt-1">
                                <button type="button" onclick="openMailClient()" class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs flex items-center gap-2 transition-colors">
                                    <i class="fa-solid fa-up-right-from-square"></i>
                                    <span>E-posta Uygulamasıyla Gönder (Hazır Taslak)</span>
                                </button>
                                <button type="button" onclick="copyRequestDetails()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-xs flex items-center gap-2 transition-colors">
                                    <i class="fa-regular fa-copy text-cyan-400"></i>
                                    <span>Talep Metnini Kopyala</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Alt Bilgi (Footer) -->
    <footer class="bg-slate-950 border-t border-slate-900 py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <span class="font-mono font-bold text-cyan-400">&lt;MA/&gt;</span>
                <span class="text-sm text-slate-400">
                    <strong class="text-slate-200">Mustafa Albayrak</strong> — Yazılım, Donanım & Bilişim Teknolojileri Uzmanı
                </span>
            </div>
            <div class="text-xs font-mono text-slate-500">
                mustafaalbayrak.net • Tüm Hakları Saklıdır © <span id="current-year"></span>
            </div>
        </div>
    </footer>

    <!-- Toast Bildirimi (Kopyalama vb. için) -->
    <div id="toast-notification" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="px-4 py-3 rounded-xl bg-slate-900 border border-cyan-500/40 text-cyan-300 text-sm font-medium shadow-xl flex items-center gap-2.5">
            <i class="fa-solid fa-check-circle text-emerald-400"></i>
            <span id="toast-message">E-posta adresi panoya kopyalandı.</span>
        </div>
    </div>

    <script>
        // =========================================================================
        // YAPILANDIRMA: E-postaların düşeceği gerçek adresinizi aşağıya yazın.
        // Not: İlk form gönderiminde FormSubmit.co bu adrese bir onay maili atar.
        // Gelen maildeki "Activate Form" butonuna 1 kez tıklamanız yeterlidir.
        // =========================================================================
        const TARGET_EMAIL = 'info@mustafaalbayrak.net';

        // Yıl ve hedef e-posta bilgisini otomatik güncelle
        document.getElementById('current-year').textContent = new Date().getFullYear();
        const displayEmailEl = document.getElementById('display-email');
        if (displayEmailEl) displayEmailEl.textContent = TARGET_EMAIL;

        // Mobil Menü Açma/Kapatma
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Hero Terminal Simülasyonu
        function runTerminalCommand(type) {
            const logEl = document.getElementById('terminal-dynamic-log');
            const messages = {
                legacy: '&gt; [MODÜL: LEGACY_RESCUE] Derlenmiş kod yapısı ve bağımlılıklar analiz edildi. Sahipsiz yazılım devralmaya hazır.<span class="cursor-blink">_</span>',
                hardware: '&gt; [MODÜL: HW_CHECK] Sunucu, disk sağlığı, ağ gecikmesi ve donanım bileşenleri test edildi. Darboğaz tespiti aktif.<span class="cursor-blink">_</span>',
                db: '&gt; [MODÜL: DB_REPAIR] SQL / Firebird / Access veri tabanı tabloları doğrulandı. İndeks onarımı ve yedekleme hazır.<span class="cursor-blink">_</span>'
            };
            logEl.innerHTML = `<span>${messages[type]}</span>`;
        }

        // İnteraktif Teşhis Aracı Verileri
        const diagnosticData = {
            unreachable: {
                badge: 'Öncelikli Kurtarma Protokolü',
                duration: 'Ön Analiz: Aynı Gün',
                title: 'Sahipsiz & Yazılımcısına Ulaşılamayan Sistem Kurtarma Planı',
                desc: 'Mevcut uygulamanızın çalıştığı sunucu veya bilgisayar ortamına güvenli bağlantı sağlanarak dosya yapısı, veri tabanı motoru ve varsa kaynak kod/derlenmiş modüller analiz edilir. Sistem çalışır haldeyken kesinti yaratmadan kontrol devralınır.',
                steps: [
                    'Tam sistem ve veri tabanı imaj yedeğinin alınması',
                    'Uygulama mimarisi, şifreler ve bağımlılıkların çözümlenmesi',
                    'Hata giderme, güncelleme ve kesintisiz bakım desteğinin başlatılması'
                ],
                categoryValue: 'Yazılımcısına Ulaşılamayan Sistem Desteği / Kurtarma'
            },
            hardware: {
                badge: 'Donanım & Altyapı Müdahalesi',
                duration: 'Müdahale: Hızlı Teşhis',
                title: 'Sunucu, İş İstasyonu ve Ağ (Network) Arıza Çözüm Planı',
                desc: 'Sistem yavaşlamaları, mavi ekran/çökme sorunları, ağ kopmaları veya sunucu darboğazları hem donanım bileşenleri hem de işletim sistemi çekirdek seviyesinde test edilerek kalıcı olarak çözülür.',
                steps: [
                    'İşlemci, RAM, disk (SMART/NVMe) ve güç bileşenlerinin stres testi',
                    'Ağ topolojisi, IP çakışmaları ve güvenlik duvarı optimizasyonu',
                    'Gerekli donanım yükseltme veya sunucu sanallaştırma geçişi'
                ],
                categoryValue: 'Donanım, Sunucu & Ağ Arıza Tespiti'
            },
            database: {
                badge: 'Kritik Veri Güvenliği',
                duration: 'Öncelik: Yüksek',
                title: 'Veri Tabanı Kurtarma, Onarım ve Otomatik Yedekleme Planı',
                desc: 'Bozulmuş tablolar, şifresi unutulmuş veri tabanları veya eski formatta sıkışmış ticari kayıtlarınız veri kaybı olmadan kurtarılır ve bulut/yerel otomatik yedekleme düzenine geçirilir.',
                steps: [
                    'Ham veri dosyalarının izole ortamda klonlanması ve onarımı',
                    'Eski veri tabanının güncel SQL / modern formatlara aktarımı',
                    'Günlük otomatik şifreli yedekleme sisteminin kurulması'
                ],
                categoryValue: 'Veri Tabanı Kurtarma, Bakım & Yedekleme'
            },
            custom: {
                badge: 'Özel Yazılım & Dijitalleşme',
                duration: 'Planlama: İhtiyaca Özel',
                title: 'İş Süreçlerine Özel Yazılım ve Otomasyon Geliştirme Planı',
                desc: 'Manuel yürütülen iş yükünüzü ortadan kaldıran, mevcut ticari yazılımlarınızla API üzerinden haberleşen hızlı, sade ve tamamen size ait yazılım çözümleri geliştirilir.',
                steps: [
                    'İş akışının ve teknik gereksinimlerin netleştirilmesi',
                    'Hızlı prototip ve modüler yazılım mimarisinin kodlanması',
                    'Kaynak kodları ve tam dokümantasyonu ile anahtar teslim kurulum'
                ],
                categoryValue: 'Özel Yazılım Geliştirme & Otomasyon'
            }
        };

        let currentSelectedDiagnostic = 'unreachable';

        function selectDiagnostic(key) {
            currentSelectedDiagnostic = key;
            const data = diagnosticData[key];

            // Sekme stillerini güncelle
            document.querySelectorAll('.diag-tab').forEach(btn => {
                btn.classList.remove('bg-cyan-500/15', 'border-cyan-500', 'text-white');
                btn.classList.add('bg-slate-900/70', 'border-slate-800', 'text-slate-300');
            });

            const activeBtn = document.getElementById(`diag-btn-${key}`);
            activeBtn.classList.remove('bg-slate-900/70', 'border-slate-800', 'text-slate-300');
            activeBtn.classList.add('bg-cyan-500/15', 'border-cyan-500', 'text-white');

            // İçeriği güncelle
            document.getElementById('diag-badge').textContent = data.badge;
            document.getElementById('diag-duration').innerHTML = `<i class="fa-regular fa-clock mr-1"></i>${data.duration}`;
            document.getElementById('diag-title').textContent = data.title;
            document.getElementById('diag-desc').textContent = data.desc;

            const stepsList = document.getElementById('diag-steps');
            stepsList.innerHTML = data.steps.map(step => `
                <li class="flex items-center gap-2.5">
                    <i class="fa-solid fa-circle-check text-cyan-400"></i>
                    <span>${step}</span>
                </li>
            `).join('');
        }

        function applyDiagnosticToForm() {
            const data = diagnosticData[currentSelectedDiagnostic];
            const categorySelect = document.getElementById('issueCategory');
            const messageInput = document.getElementById('message');
            const contactSection = document.getElementById('iletisim');

            categorySelect.value = data.categoryValue;
            if (!messageInput.value.trim()) {
                messageInput.value = `Merhaba Mustafa Bey, "${data.title}" konusunda teknik destek ve ön inceleme talep ediyorum. Sistem detayları: `;
            }

            contactSection.scrollIntoView({ behavior: 'smooth' });
            setTimeout(() => {
                document.getElementById('fullName').focus();
            }, 600);
        }

        // E-posta Kopyalama (execCommand fallback ile iFrame uyumlu)
        function copyEmail() {
            copyToClipboard(TARGET_EMAIL, `${TARGET_EMAIL} panoya kopyalandı.`);
        }

        function copyToClipboard(text, toastMsg) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast(toastMsg);
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-notification');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        // Form verilerini okuyan yardımcı fonksiyon
        function getFormValues() {
            return {
                name: document.getElementById('fullName').value.trim() || 'Belirtilmedi',
                contact: document.getElementById('contactInfo').value.trim() || 'Belirtilmedi',
                category: document.getElementById('issueCategory').value,
                message: document.getElementById('message').value.trim() || 'Detay girilmedi.'
            };
        }

        // Bilgisayar/telefonun varsayılan e-posta istemcisini hazır taslakla açar
        function openMailClient() {
            const data = getFormValues();
            const subject = encodeURIComponent(`[Teknik Destek Talebi] ${data.category} - ${data.name}`);
            const body = encodeURIComponent(
                `Ad Soyad / Firma: ${data.name}\n` +
                `İletişim Bilgisi: ${data.contact}\n` +
                `Destek Kategorisi: ${data.category}\n\n` +
                `Sistem ve Sorun Detayı:\n${data.message}`
            );
            window.location.href = `mailto:${TARGET_EMAIL}?subject=${subject}&body=${body}`;
        }

        // Talep metnini panoya kopyalar
        function copyRequestDetails() {
            const data = getFormValues();
            const formattedText =
                `Alıcı: ${TARGET_EMAIL}\n` +
                `Konu: [Teknik Destek Talebi] ${data.category}\n` +
                `Ad Soyad / Firma: ${data.name}\n` +
                `İletişim: ${data.contact}\n` +
                `Detay: ${data.message}`;
            copyToClipboard(formattedText, 'Talep metni panoya kopyalandı.');
        }

        // Gerçek E-Posta Gönderim İşlemi (FormSubmit.co AJAX API)
        document.getElementById('support-form').addEventListener('submit', async function(e) {
            e.preventDefault();

            const data = getFormValues();
            const submitBtn = document.getElementById('submit-btn');
            const submitIcon = document.getElementById('submit-icon');
            const submitText = document.getElementById('submit-text');
            const successBox = document.getElementById('form-success-box');
            const errorBox = document.getElementById('form-error-box');

            // Önceki bildirimleri gizle ve yükleniyor durumuna geç
            successBox.classList.add('hidden');
            errorBox.classList.add('hidden');
            submitBtn.disabled = true;
            submitIcon.className = 'fa-solid fa-circle-notch fa-spin';
            submitText.textContent = 'E-posta Gönderiliyor...';

            try {
                const response = await fetch(`https://formsubmit.co/ajax/${encodeURIComponent(TARGET_EMAIL)}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        _subject: `Yeni Teknik Destek Talebi: ${data.category} (${data.name})`,
                        _template: 'table',
                        _captcha: 'false',
                        'Ad_Soyad_Firma': data.name,
                        'Iletisim_Bilgisi': data.contact,
                        'Destek_Kategorisi': data.category,
                        'Sistem_ve_Sorun_Detayi': data.message
                    })
                });

                const result = await response.json();

                if (response.ok && (result.success === 'true' || result.success === true)) {
                    document.getElementById('form-success-detail').innerHTML =
                        `Sayın <strong>${data.name}</strong>, <em>"${data.category}"</em> konulu talebiniz <strong>${TARGET_EMAIL}</strong> adresine iletildi. En kısa sürede size dönüş yapılacaktır.`;
                    successBox.classList.remove('hidden');
                    this.reset();
                    showToast('E-posta başarıyla gönderildi!');
                } else {
                    throw new Error(result.message || 'Sunucu yanıtı doğrulanamadı.');
                }
            } catch (err) {
                // Önizleme iframe kısıtlaması veya ağ hatası durumunda yedek seçenekleri göster
                errorBox.classList.remove('hidden');
                showToast('Otomatik gönderim yapılamadı, alternatif seçenekler açıldı.');
            } finally {
                submitBtn.disabled = false;
                submitIcon.className = 'fa-solid fa-paper-plane';
                submitText.textContent = 'Talebi Gönder ve Ön Analiz İste';
            }
        });
    </script>
</body>
</html>
